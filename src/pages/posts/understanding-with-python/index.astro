---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
import { POST_TOPICS } from "@/config/postTopics";

const locale = Astro.currentLocale ?? config.site.lang;
const collection = POST_TOPICS.understandingWithPython;
const posts = getSortedPosts(await getCollection("posts"));
const seriesList = Object.values(collection.series).map((series) => ({
  ...series,
  posts: posts.filter((post) =>
    post.id.startsWith(`${collection.slug}/${series.slug}/`),
  ),
  url: getRelativeLocaleUrl(locale, `posts/${collection.slug}/${series.slug}`),
}));
---

<Layout
  title={`${collection.title} | ${config.site.title}`}
  description={collection.description}
>
  <Header />
  <Breadcrumb />

  <Main pageTitle={collection.title} pageDesc={collection.description}>
    <section aria-labelledby="collection-series-title" class="mt-8">
      <h2 id="collection-series-title" class="sr-only">Python 시리즈</h2>
      <div class="space-y-6">
        {
          seriesList.map((series) => (
            <a
              href={series.url}
              class="focus-outline border-border hover:border-accent group block rounded-lg border p-6 transition-colors sm:p-8"
            >
              <div class="mb-4 flex items-center justify-between gap-4">
                <span class="bg-accent/10 text-accent rounded-full px-3 py-1 text-sm font-medium">
                  에피소드 · {series.posts.length}/{series.episodeCount}
                </span>
                <IconArrowRight
                  aria-hidden="true"
                  class="text-accent size-6 transition-transform group-hover:translate-x-1 rtl:-rotate-180"
                />
              </div>
              <h3 class="text-accent text-xl font-semibold sm:text-2xl">
                {series.title}
              </h3>
              <p class="mt-3 whitespace-pre-line text-sm leading-7 sm:text-base">
                {series.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </Main>

  <Footer />
</Layout>
